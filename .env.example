# Copy this file to .env in the same folder as compose.yaml.
# No password is supplied. Choose a UNIQUE password with at least 16 characters,
# using at least 3 of uppercase/lowercase/digits/symbols. A password manager is best.
# Use single quotes around your value to keep $ and # literal in Compose .env syntax.
TRAVEL_PASSWORD=
# REQUIRED: replace with your REAL reverse-proxy hostname, no scheme/path.
# Example PLACEHOLDER ONLY: travel.your-domain.example
# Include :port if you access a non-default port. Comma-separate exact authorities.
TRAVEL_ALLOWED_HOSTS=
# Keep true for all NAS/LAN/remote use behind HTTPS. See START_HERE.md.
# false is ONLY for isolated loopback development on a trusted computer, never a NAS/LAN shortcut.
TRAVEL_SECURE_COOKIE=true
